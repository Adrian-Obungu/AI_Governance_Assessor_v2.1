# Docker database configuration
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password
POSTGRES_DB=ai_governance_db
DATABASE_URL=postgresql+psycopg2://ai_user:ai_password@db:5432/ai_governance_db

# Security settings — replace SECRET_KEY outside local throwaway testing
SECRET_KEY=local-development-secret-change-before-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password security
BCRYPT_ROUNDS=12

# Account lockout settings
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Email configuration (mock implementation for local development)
EMAIL_ENABLED=false
EMAIL_FROM=noreply@aigovernance.local
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Frontend configuration
FRONTEND_URL=http://localhost

# Backend configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CLI configuration when run from the host
API_BASE_URL=http://localhost:8000

# Environment
ENVIRONMENT=development

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:5173

# Logging
LOG_LEVEL=INFO
